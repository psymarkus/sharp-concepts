                                   owl:versionIRI <https://w3id.org/sharp/ontology/0.1.0-webprotege> ;
                                   owl:imports <http://www.w3.org/2004/02/skos/core> ;
                                   <http://purl.org/dc/terms/creator> "Markus Gödker, Constanze Richters, Olga Chernikova, Matthias Stadler, Doris Holzberger, Frank Fischer, SHARP Consortium" ;
                                   <http://purl.org/dc/terms/description> "Collaborative SKOS vocabulary for SHARP concept labels and definitions (optimized for WebProtégé rendering)."@en ;
                                   <http://purl.org/dc/terms/title> "SHARP SKOS Concepts"@en ;
                                   owl:versionInfo "0.1.0-webprotege" .

